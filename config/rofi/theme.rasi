configuration {
    show-icons:          true;
    drun-display-format: "{name}";
}

* {
    bg-transparent:      rgba(26, 27, 28, 0.65);
    bg-selected:         rgba(255, 255, 255, 0.15);
    fg-white:            #ffffff;
    
    font:                "JetBrainsMono Nerd Font 11";
    background-color:    transparent;
    text-color:          @fg-white;
}

window {
    background-color:    @bg-transparent;
    border:              1px;
    border-color:        rgba(255, 255, 255, 0.1);
    border-radius:       12px;
    width:               500px;
    padding:             20px;
}

mainbox {
    children:            [ inputbar, listview ];
    spacing:             10px;
}

inputbar {
    background-color:    rgba(255, 255, 255, 0.05);
    border-radius:       8px;
    padding:             8px 12px;
    children:            [ entry ]; 
}

entry {
    placeholder:         "Buscar aplicación...";
    placeholder-color:   rgba(255, 255, 255, 0.4);
    text-color:          @fg-white;
}

listview {
    fixed-height:        0;
    lines:               8;
    spacing:             5px;
    scrollbar:           false;
}

element {
    padding:             8px;
    border-radius:       6px;
    children:            [ element-icon, element-text ];
}

element selected {
    background-color:    @bg-selected;
    text-color:          @fg-white;
}

element-text {
    vertical-align:      0.5;
    text-color:          inherit;
}

element-icon {
    size:                24px;
    margin:              0px 10px 0px 0px;
    background-color:    transparent;
}
